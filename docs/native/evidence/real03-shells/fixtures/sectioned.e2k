$ PROGRAM INFORMATION
 PROGRAM "ETABS" VERSION "23.2.0"
$ CONTROLS
 UNITS "Kip" "ft" "F"
$ STORIES - IN SEQUENCE FROM TOP
 STORY "Roof" HEIGHT 10
 STORY "Base" ELEV 0
$ FRAME SECTIONS
 FRAMESECTION "RECT" MATERIAL "C" SHAPE "Concrete Rectangular" D 2 B 1
 FRAMESECTION "TUBE" MATERIAL "S" SHAPE "Steel Tube" D 1 B 1
 FRAMESECTION "ROUND" MATERIAL "C" SHAPE "Concrete Circle" D 1.5
 FRAMESECTION "W14" MATERIAL "S" SHAPE "W14X90" FILE "AISC16"
$ POINT COORDINATES
 POINT "1" 0 0
 POINT "2" 10 0
 POINT "3" 10 10
 POINT "4" 0 10
$ LINE CONNECTIVITIES
 LINE "C" COLUMN "1" "1" 1
 LINE "B" BEAM "1" "2" 0
 LINE "G" BEAM "2" "3" 0
 LINE "K" BEAM "3" "4" 0
 LINE "X" BRACE "4" "2" 0
 LINE "T" BEAM "4" "1" 0
 LINE "N" BRACE "1" "3" 0
$ AREA CONNECTIVITIES
 AREA "S" FLOOR 4 "1" "2" "3" "4" 0 0 0 0
$ LINE ASSIGNS
 LINEASSIGN "C" "Roof" SECTION "RECT"
 LINEASSIGN "B" "Roof" SECTION "RECT" CARDINALPT 8
 LINEASSIGN "G" "Roof" SECTION "ROUND"
 LINEASSIGN "K" "Roof" SECTION "W14"
 LINEASSIGN "X" "Roof" SECTION "RECT" CARDINALPT 5
 LINEASSIGN "T" "Roof" SECTION "TUBE" CARDINALPT 5
 LINEASSIGN "N" "Roof" SECTION "NOPE"
$ AREA ASSIGNS
 AREAASSIGN "S" "Roof" OPENING "NO"
$ END OF MODEL FILE
