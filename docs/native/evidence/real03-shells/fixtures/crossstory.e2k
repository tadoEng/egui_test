$ PROGRAM INFORMATION
 PROGRAM "ETABS" VERSION "23.2.0"
$ CONTROLS
 UNITS "Kip" "ft" "F"
$ STORIES - IN SEQUENCE FROM TOP
 STORY "Mezz" HEIGHT 0.001
 STORY "Roof" HEIGHT 10
 STORY "Base" ELEV 0
$ POINT COORDINATES
 POINT "1" 0 0
 POINT "2" 10 0
 POINT "3" 10 10
 POINT "4" 0 10
 POINT "5" 4 4
 POINT "6" 6 4
 POINT "7" 6 6
 POINT "8" 4 6
 POINT "9" 20 0
 POINT "10" 30 0
 POINT "11" 30 10
 POINT "12" 20 10
$ LINE CONNECTIVITIES
 LINE "C" COLUMN "1" "1" 1
 LINE "B" BEAM "1" "2" 0
$ AREA CONNECTIVITIES
 AREA "S" FLOOR 4 "1" "2" "3" "4" 0 0 0 0
 AREA "VOID" FLOOR 4 "5" "6" "7" "8" 0 0 0 0
 AREA "R" FLOOR 4 "9" "10" "11" "12" 0 0 0 0
 AREA "W" PANEL 4 "2" "3" "3" "2" 0 0 0 0
$ LINE ASSIGNS
 LINEASSIGN "C" "Roof"
 LINEASSIGN "B" "Roof"
$ AREA ASSIGNS
 AREAASSIGN "S" "Roof" OPENING "NO"
 AREAASSIGN "VOID" "Mezz" OPENING "YES"
 AREAASSIGN "R" "Roof" OPENING "NO"
 AREAASSIGN "W" "Roof" OPENING "NO"
$ END OF MODEL FILE
